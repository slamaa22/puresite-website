# ============================================================================
# PureSite Open-Source Cookieless Analytics (Umami — https://umami.is)
# ============================================================================
# Variante A (0 € Cloud, 60 Sek.): https://cloud.umami.is (EU-Region wählen)
# Variante B (100 % Self-Hosted):  Coolify -> + New Resource -> Umami Template
#
# Trage hier (oder in Coolify unter Environment Variables) deine Website-ID ein:
VITE_UMAMI_WEBSITE_ID=

# Optional: Nur nötig bei Self-Hosting auf eigenem Coolify-Server
# (Standard ist https://cloud.umami.is/script.js)
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
